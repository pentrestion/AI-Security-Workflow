{
  "mcpServers": {
    "ghidra": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/LaurieWired/GhidraMCP",
        "ghidra-mcp"
      ],
      "env": {
        "GHIDRA_HOME": "${CLAUDE_PROJECT_DIR}/tools/ghidra"
      }
    },
    "ida": {
      "command": "uvx",
      "args": ["ida-hcli", "mcp", "serve"],
      "env": {
        "IDA_PATH": "${CLAUDE_PROJECT_DIR}/tools/ida"
      }
    },
    "binaryninja": {
      "command": "uvx",
      "args": ["binaryninja-mcp", "server"]
    }
  }
}
